{
  "name": "@thezelijah/majik-user",
  "type": "module",
  "description": "Majik User is a framework-agnostic, self-defending user domain model for managing identity, profile data, verification state, and application settings in modern apps and websites. It’s designed to be extensible, serializable, and safe by default, acting as a single source of truth for user data across frontends, backends, and auth providers.",
  "version": "1.0.6",
  "license": "Apache-2.0",
  "author": "Zelijah",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jedlsf/majik-user.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "keywords": [
    "user",
    "user-model",
    "user-management",
    "identity",
    "profile",
    "account",
    "auth",
    "authentication",
    "authorization",
    "verification",
    "domain-model",
    "data-model",
    "typescript",
    "framework-agnostic",
    "supabase",
    "web-app",
    "backend",
